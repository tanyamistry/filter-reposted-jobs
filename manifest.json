{
  "manifest_version": 3,
  "name": "Filter Reposted Jobs",
  "version": "0.1.0",
  "description": "Hides reposted jobs from LinkedIn job search and keeps a local record of the jobs you've applied to.",

  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*"],

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Filter reposted jobs",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": [
        "src/shared/storage.js",
        "src/content/config.js",
        "src/content/content.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
